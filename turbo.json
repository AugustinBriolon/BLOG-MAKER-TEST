{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "sanity:typegen": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["sanity:typegen"],
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
