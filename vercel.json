{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "studio": {
      "root": "studio",
      "framework": "sanity"
    }
  },
  "rewrites": [
    {
      "source": "/studio/(.*)",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/studio",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/vendor/(.*)",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
